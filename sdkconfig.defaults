CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_0=y

# Flash — ต้องตรงกับ hardware (4MB, DIO, 40MHz) ไม่งั้น bootloader crash
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHMODE="dio"
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_ESPTOOLPY_FLASHFREQ="40m"
CONFIG_ESPTOOLPY_FLASH_SAMPLE_MODE_STR=y

# PSRAM — frame buffer ของ MIPI DSI ต้องใช้ SPIRAM, ESP32-P4 ใช้ HEX mode
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y

# LVGL fonts สำหรับ UI ขนาดใหญ่
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_MONTSERRAT_48=y

# LVGL heap — 128KB primary (SRAM) + 256KB expand (PSRAM) รองรับ exec-detail screen
CONFIG_LV_MEM_SIZE_KILOBYTES=128
CONFIG_LV_MEM_POOL_EXPAND_SIZE_KILOBYTES=256

# Ethernet — IP101 PHY via RMII (ESP32-P4 native EMAC)
CONFIG_ETH_USE_ESP32_EMAC=y
CONFIG_ETH_PHY_IP101=y

# SPIFFS filesystem สำหรับเก็บ logo.png
CONFIG_SPIFFS_USE_MAGIC=y
CONFIG_SPIFFS_MAX_PARTITIONS=3

# LVGL PNG decoder
CONFIG_LV_USE_LODEPNG=y

# LVGL JPEG decoder (TJpgDec) — รองรับทั้ง PNG และ JPEG
CONFIG_LV_USE_TJPGD=y

# LVGL QR code widget — used on ETH setup screen
CONFIG_LV_USE_QRCODE=y

# LVGL POSIX filesystem driver — drive 'A' map → /spiffs
CONFIG_LV_USE_FS_POSIX=y
CONFIG_LV_FS_POSIX_LETTER=65
CONFIG_LV_FS_POSIX_PATH="/spiffs"
CONFIG_LV_FS_POSIX_CACHE_SIZE=0

# Main task stack — eth_upload_start() runs Ethernet+HTTP init inline, needs > 4KB default
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# WDT timeout — 5s ตรวจเจอ deadlock เร็ว
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5

